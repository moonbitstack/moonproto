///|
let cached_google_protobuf_descriptor_proto : @reflect.FileDescriptor = file_descriptor_google_protobuf_descriptor_proto() catch {
  _ => abort("moonproto: descriptor could not be built")
}

///|
fn find_in_google_protobuf_descriptor_proto(
  items : Array[@reflect.MessageDescriptor],
  name : String,
) -> @reflect.MessageDescriptor? {
  for item in items {
    if item.full_name == name {
      return Some(item)
    }
    match find_in_google_protobuf_descriptor_proto(item.nested_messages, name) {
      Some(found) => return Some(found)
      None => ()
    }
  }
  None
}

///|
fn find_message_google_protobuf_descriptor_proto(
  name : String,
) -> @reflect.MessageDescriptor {
  match
    find_in_google_protobuf_descriptor_proto(
      cached_google_protobuf_descriptor_proto.messages,
      name,
    ) {
    Some(found) => found
    None => abort("moonproto: missing " + name)
  }
}

///|
pub(all) enum Edition {
  EDITION_UNKNOWN
  EDITION_LEGACY
  EDITION_PROTO2
  EDITION_PROTO3
  EDITION_2023
  EDITION_2024
  EDITION_2026
  EDITION_UNSTABLE
  EDITION_1_TEST_ONLY
  EDITION_2_TEST_ONLY
  EDITION_99997_TEST_ONLY
  EDITION_99998_TEST_ONLY
  EDITION_99999_TEST_ONLY
  EDITION_MAX
  Unknown(Int32)
}

///|
pub fn Edition::code(self : Edition) -> Int32 {
  match self {
    EDITION_UNKNOWN => 0
    EDITION_LEGACY => 900
    EDITION_PROTO2 => 998
    EDITION_PROTO3 => 999
    EDITION_2023 => 1000
    EDITION_2024 => 1001
    EDITION_2026 => 1002
    EDITION_UNSTABLE => 9999
    EDITION_1_TEST_ONLY => 1
    EDITION_2_TEST_ONLY => 2
    EDITION_99997_TEST_ONLY => 99997
    EDITION_99998_TEST_ONLY => 99998
    EDITION_99999_TEST_ONLY => 99999
    EDITION_MAX => 2147483647
    Unknown(n) => n
  }
}

///|
pub fn Edition::of(n : Int32) -> Edition {
  match n {
    0 => EDITION_UNKNOWN
    900 => EDITION_LEGACY
    998 => EDITION_PROTO2
    999 => EDITION_PROTO3
    1000 => EDITION_2023
    1001 => EDITION_2024
    1002 => EDITION_2026
    9999 => EDITION_UNSTABLE
    1 => EDITION_1_TEST_ONLY
    2 => EDITION_2_TEST_ONLY
    99997 => EDITION_99997_TEST_ONLY
    99998 => EDITION_99998_TEST_ONLY
    99999 => EDITION_99999_TEST_ONLY
    2147483647 => EDITION_MAX
    _ => Unknown(n)
  }
}

///|
