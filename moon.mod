name = "moonbitstack/moonproto"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonproto"

license = "Apache-2.0"

keywords = [
  "protobuf",
  "protocol-buffers",
  "proto",
  "proto2",
  "proto3",
  "editions",
  "serialization",
  "deserialization",
  "binary",
  "wire-format",
  "varint",
  "codegen",
  "protoc",
  "protoc-plugin",
  "descriptor",
  "reflection",
  "dynamic-message",
  "protojson",
  "prototext",
  "text-format",
  "well-known-types",
  "any",
  "timestamp",
  "duration",
  "field-mask",
  "struct",
  "grpc",
  "rpc",
  "idl",
  "schema",
  "parser",
  "encoder",
  "decoder",
  "moonbit",
]

description = "Protocol Buffers for MoonBit."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.5.0",
  "moonbitstack/moonjson@0.5.0",
}
